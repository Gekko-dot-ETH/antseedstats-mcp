{
  "name": "@antseedstats/mcp-server",
  "version": "0.1.2",
  "description": "MCP server for AntSeedStats: the AntSeed AI-inference marketplace on Base (sellers, models, prices, epochs, $ANTS) for AI clients",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "antseedstats-mcp": "bin/antseedstats-mcp.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "test": "tsx --test tests/*.test.ts",
    "sync-catalog": "tsx scripts/sync-catalog.ts",
    "check-drift": "tsx scripts/check-drift.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "antseed",
    "ants",
    "base",
    "ai-inference",
    "marketplace",
    "analytics",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gekko-dot-ETH/antseedstats-mcp.git"
  },
  "homepage": "https://antseedstats.com/developers",
  "bugs": {
    "url": "https://github.com/Gekko-dot-ETH/antseedstats-mcp/issues"
  },
  "author": "gekko.eth"
}
